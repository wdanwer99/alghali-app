# Copy this file to `.env` in the repo root and fill in the values yourself.
# `.env` is git-ignored. Never paste these values into chat, issues or commits.
#
# Where to find them (Supabase dashboard, per project):
#   Project ref ............ Project Settings → General → Project ID
#   URL / keys ............. Project Settings → API Keys  (publishable key = client-safe; secret key = server only)
#   DB URL ................. Connect → Session pooler connection string (port 5432), with your DB password filled in
#
# `pnpm env:sync` copies the client-safe values into apps/admin/.env.local and apps/*/env/dev.json.

# --- alghali-dev: what the apps talk to while developing ---
SUPABASE_DEV_PROJECT_REF=your-dev-project-ref
SUPABASE_DEV_URL=https://your-dev-project-ref.supabase.co
SUPABASE_DEV_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_DEV_SECRET_KEY=sb_secret_xxx
SUPABASE_DEV_DB_URL=postgresql://postgres.your-dev-project-ref:YOUR-DB-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- alghali-test: wiped and re-migrated by the test suite; never point this at dev ---
SUPABASE_TEST_PROJECT_REF=your-test-project-ref
SUPABASE_TEST_URL=https://your-test-project-ref.supabase.co
SUPABASE_TEST_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_TEST_SECRET_KEY=sb_secret_xxx
SUPABASE_TEST_DB_URL=postgresql://postgres.your-test-project-ref:YOUR-DB-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- alghali-live: real users (M7, docs/DEPLOY.md). No demo data, ever ---
SUPABASE_LIVE_PROJECT_REF=your-live-project-ref
SUPABASE_LIVE_URL=https://your-live-project-ref.supabase.co
SUPABASE_LIVE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_LIVE_SECRET_KEY=sb_secret_xxx
SUPABASE_LIVE_DB_URL=postgresql://postgres.your-live-project-ref:YOUR-DB-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- monitoring (optional; Sentry stays disabled while empty) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
